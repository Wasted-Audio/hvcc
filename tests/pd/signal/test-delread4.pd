#N canvas 0 22 520 360 10;
#X text 10 25 phasor~ frequencies give exactly representable increments so heavy and Pd see identical input;
#X text 10 10 delwrite~ is sorted before delread4~/vd~ (subpatch connection) \, so Pd's minimum delay is 1 sample;
#N canvas 0 22 450 300 write 0;
#X obj 10 10 phasor~ 3468.75;
#X obj 10 40 *~;
#X obj 10 70 -~;
#X obj 10 100 *~ 4;
#X obj 10 130 delwrite~ \$0-d4 50;
#X obj 150 130 outlet~;
#X connect 0 0 1 0;
#X connect 0 0 1 1;
#X connect 0 0 2 0;
#X connect 1 0 2 1;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 3 0 5 0;
#X restore 10 40 pd write;
#N canvas 0 22 450 300 read 0;
#X obj 10 10 inlet~;
#X obj 10 40 sig~ 3.2137;
#X obj 10 70 delread4~ \$0-d4;
#X obj 150 10 phasor~ 0.732421875;
#X obj 150 40 *~ 30;
#X obj 150 70 +~ -1;
#X obj 150 100 vd~ \$0-d4;
#X obj 10 130 outlet~;
#X obj 150 130 outlet~;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 2 0 7 0;
#X connect 6 0 8 0;
#X restore 10 70 pd read;
#X text 100 70 left: fixed 3.2137 ms \, right: sweep -1 ... 29 ms (clamped below 1 sample);
#X obj 10 110 dac~ 1 2;
#X connect 2 0 3 0;
#X connect 3 0 5 0;
#X connect 3 1 5 1;
